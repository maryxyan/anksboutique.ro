# =============================================================================
# Anks Boutique - Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values:
#   cp .env.example .env
# =============================================================================

# ── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL connection string
DATABASE_URL="postgresql://anksboutique:password123@localhost:5432/anksboutique"

# ── Server ────────────────────────────────────────────────────────────────────
# Port for the API server to listen on
PORT="8080"

# Node environment: development | production
NODE_ENV="development"

# Base URL of the API server (used for Netopia return/callback URLs)
# In production, this would be your domain: https://api.anksboutique.ro
APP_BASE_URL="http://localhost:8080"

# Frontend URL (used for CORS and redirect links)
FRONTEND_URL="http://localhost:5173"

# ── Netopia (MobilPay) - Payment Processor ────────────────────────────────────
# Netopia merchant account identifier (received after onboarding)
NETOPIA_MERCHANT_ID="3FUE-V0GG-LWUE-LUNQ-P8O7"

# Netopia API key/token for authentication (used as <signature> in payment XML)
NETOPIA_API_KEY="if4aeDyBGwfncloh9986Cth7JmYTrFA8fX3XRlrgXTZMWus_B3X9zx1Sie5N"

# Netopia public RSA key (provided by Netopia) - used to encrypt payment requests
# Path to PEM file or the raw base64-encoded key
NETOPIA_PUBLIC_KEY_PATH=""

# Netopia private RSA key (provided by Netopia) - used to decrypt IPN callbacks
# Path to PEM file or the raw base64-encoded key
NETOPIA_PRIVATE_KEY_PATH=""


# Set to "true" to use Netopia sandbox/test environment
# Set to "false" for production (real payments)
NETOPIA_SANDBOX="false"

# Netopia payment page URL (overridden automatically based on sandbox setting)
# Sandbox: https://sandboxsecure.mobilpay.ro/card/
# Live:    https://secure.mobilpay.ro/card/
NETOPIA_PAYMENT_URL="https://netopia-payments.com"

# Netopia API URL for direct calls (if needed)
# Sandbox: https://sandboxapi.mobilpay.ro
# Live:    https://api.mobilpay.ro
NETOPIA_API_URL="https://secure.netopia-payments.com"

