# =============================================================================
# Anks Boutique - Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values:
#   cp .env.example .env
# =============================================================================

# ── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL connection string
DATABASE_URL="postgresql://anksboutique:change-me@localhost:5432/anksboutique"

# ── Server ────────────────────────────────────────────────────────────────────
# Port for the API server to listen on
PORT="8080"

# Node environment: development | production
NODE_ENV="development"

# Optional application log file. When set, logs are written to this file in addition to stdout/stderr.
# In production, a default file is used if this is not set.
# Example: ./logs/api-server.log
LOG_FILE_PATH="./logs/api-server.log"

# Base URL of the API server (used for Netopia return/callback URLs)
# In production, this would be your domain: https://api.anksboutique.ro
APP_BASE_URL="http://localhost:8080"

# Frontend URL (used for CORS and redirect links)
FRONTEND_URL="http://localhost:5173"

# Email notifications. ADMIN_EMAIL defaults to contact@anksboutique.ro.
ADMIN_EMAIL="contact@anksboutique.ro"
MAIL_FROM="contact@anksboutique.ro"
MAIL_FROM_NAME="Ank's Boutique"
# Optional overrides when PHP or the mail helper are not on their default paths.
PHP_BINARY="php"
MAIL_SCRIPT_PATH=""

# ── Netopia (MobilPay) - Payment Processor ────────────────────────────────────
# Netopia merchant account identifier (received after onboarding)
NETOPIA_MERCHANT_ID="your-merchant-id"

# Netopia API key/token for newer JSON APIs; legacy XML checkout uses NETOPIA_MERCHANT_ID as <signature>
NETOPIA_API_KEY="your-api-key"

# Netopia public RSA key (provided by Netopia) - used to encrypt payment requests
# Set NETOPIA_PUBLIC_KEY_PEM for inline PEM text, or NETOPIA_PUBLIC_KEY_PATH for a file path.
NETOPIA_PUBLIC_KEY_PEM=""
NETOPIA_PUBLIC_KEY_PATH=""

# Netopia private RSA key (provided by Netopia) - used to decrypt IPN callbacks
# Set NETOPIA_PRIVATE_KEY_PEM for inline PEM text, or NETOPIA_PRIVATE_KEY_PATH for a file path.
NETOPIA_PRIVATE_KEY_PEM=""
NETOPIA_PRIVATE_KEY_PATH=""


# Set to "true" to use Netopia sandbox/test environment
# Set to "false" for production (real payments)
NETOPIA_SANDBOX="false"

# Netopia payment page URL (overridden automatically based on sandbox setting)
# Sandbox: https://sandboxsecure.mobilpay.ro
# Live:    https://secure.mobilpay.ro
NETOPIA_PAYMENT_URL="https://secure.mobilpay.ro"

# Netopia API URL for direct calls (if needed)
# Sandbox: https://sandboxapi.mobilpay.ro
# Live:    https://api.mobilpay.ro
NETOPIA_API_URL="https://api.mobilpay.ro"

