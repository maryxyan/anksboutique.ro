# PHP upload limits - 15MB max file, 17MB max post (accounts for form fields + file)
php_value upload_max_filesize 15M
php_value post_max_size 17M
php_value max_execution_time 300
php_value max_input_time 120

RewriteEngine On

# Redirect /sitemap.xml to API endpoint# PHP upload limits - 15MB max
php_value upload_max_filesize 15M
php_value post_max_size 17M
php_value max_execution_time 300
php_value max_input_time 120

RewriteEngine On

# Redirect /sitemap.xml to API endpoint
RewriteRule ^sitemap\.xml$ /api/sitemap.xml [L,R=301]

# Prerender: rutele principale prin PHP pentru crawlers
RewriteRule ^$ /prerender.php [L]
RewriteRule ^shop$ /prerender.php [L]
RewriteRule ^product/(\d+)$ /prerender.php [L]

# API calls - forward to proxy
RewriteRule ^api/(.*)$ /api-proxy.php [L,QSA]

# Static assets - serve directly
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^assets/ - [L]
RewriteRule ^favicon\. - [L]
RewriteRule ^robots\.txt$ - [L]

# Admin SPA routes - redirect to SPA instead of legacy PHP admin
RewriteRule ^admin(.*)$ /index.html [L]

# SPA fallback - toate celelalte rute servesc index.html
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule . /index.html [L]
