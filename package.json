{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "preinstall": "node -e \"try { require('fs').unlinkSync('package-lock.json') } catch(e){} try { require('fs').unlinkSync('yarn.lock') } catch(e){}\"",
    "start": "pnpm --filter @workspace/scripts start",
    "build": "pnpm run typecheck && pnpm -r --if-present run build",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck"
  },
  "private": true,
  "devDependencies": {
    "esbuild": "0.27.3",
    "prettier": "^3.8.3",
    "typescript": "~5.9.3"
  }
}